# KV Fee Helper API: every setting, with its default. Copy to .env locally.

ENVIRONMENT=development                # development | test | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- database (SQL Server) ----
# Default (omit to use it): local default instance, Windows authentication, database KVFees (auto-created).
# DATABASE_URL=mssql+pyodbc://@localhost/KVFees?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# SQL login instead of Windows auth:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@localhost/KVFees?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
# Named instance: use  @localhost\SQLEXPRESS  as the host part.
DATABASE_SCHEMA=                       # optional; empty = dbo
# Tests use their own database; its name must contain "test" (default: KVFees_Test, auto-created).
# TEST_DATABASE_URL=mssql+pyodbc://@localhost/KVFees_Test?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
MIGRATE_ON_START=true                  # create DB if missing + alembic upgrade head on startup

# ---- auth ----
JWT_SECRET=change-me-to-64-random-characters
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
INDEX_HMAC_KEY=change-me-to-32-random-characters

# ---- OTP delivery ----
OTP_PROVIDER=console                   # console (logs + returns dev_code in development) | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

REMINDER_DAYS_BEFORE=3
